---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => data.status === 'published');
  
  const categories = [...new Set(allPosts.flatMap((post) => post.data.category))];

  return categories.map((category) => {
    const posts = allPosts.filter((post) => post.data.category.includes(category));
    const slug = category.toLowerCase().replace(/\s+/g, '-');
    
    return {
      params: { category: slug },
      props: { 
        category,
        posts: posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
      },
    };
  });
}

const { category, posts } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`${category} Posts`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <header class="mb-12">
      <nav class="mb-4">
        <a href={`${base}blog/`} class="text-orange hover:text-amber-500 transition-colors">
          Back to all posts
        </a>
      </nav>
      <h1 class="text-5xl font-bold mb-4 gradient-text">{category}</h1>
      <p class="text-xl text-gray-400">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'} in this category
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map((post) => (
        <PostCard
          title={post.data.title}
          date={post.data.date}
          category={post.data.category}
          tags={post.data.tags}
          thumbnail={post.data.thumbnail}
          slug={post.slug}
          excerpt={post.body.slice(0, 150).replace(/[#*`]/g, '') + '...'}
        />
      ))}
    </div>
  </div>
</BaseLayout>
