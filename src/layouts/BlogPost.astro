---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date: Date;
  author: string;
  category: string;
  tags: string[];
  thumbnail?: string;
}

const { title, date, author, category, tags, thumbnail } = Astro.props;
const base = import.meta.env.BASE_URL;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(date);

// Calculate reading time (rough estimate: 200 words per minute)
const content = await Astro.slots.render('default');
const words = content.split(/\s+/).length;
const readingTime = Math.ceil(words / 200);
---

<BaseLayout title={title}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Hero Image -->
    {thumbnail && (
      <div class="aspect-video w-full overflow-hidden rounded-xl mb-8 border border-gray-800">
        <img 
          src={thumbnail?.startsWith("http") ? thumbnail : `${base}${thumbnail?.replace(/^\//, "")}`} 
          alt={title}
          class="w-full h-full object-cover animate-hero-img"
        />
      </div>
    )}

    <!-- Header -->
    <header class="mb-12">
      <!-- Category -->
      <div class="mb-4 animate-subtitle">
        <a 
          href={`${base}category/${category.toLowerCase().replace(/\s+/g, '-')}/`}
          class="inline-block px-4 py-1.5 text-sm font-semibold bg-orange/20 text-orange rounded-full hover:bg-orange/30 transition-colors"
        >
          {category}
        </a>
      </div>

      <!-- Title -->
      <h1 class="text-4xl md:text-5xl font-bold mb-6 gradient-text animate-title">
        {title}
      </h1>

      <!-- Meta info -->
      <div class="flex flex-wrap items-center gap-4 text-gray-400 text-sm animate-meta">
        <div class="flex items-center">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
          {author}
        </div>
        <div class="flex items-center">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          {formattedDate}
        </div>
        <div class="flex items-center">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          {readingTime} min read
        </div>
      </div>
    </header>

    <!-- Content -->
    <div class="prose prose-invert max-w-none">
      <slot />
    </div>

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="mt-12 pt-8 border-t border-gray-800">
        <h3 class="text-lg font-semibold mb-4 text-orange">Tags</h3>
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="px-3 py-1.5 bg-gray-800 text-gray-300 rounded-full text-sm hover:bg-gray-700 transition-colors">
              {tag}
            </span>
          ))}
        </div>
      </div>
    )}

    <!-- Back to blog -->
    <div class="mt-12 pt-8 border-t border-gray-800">
      <a 
        href={`${base}blog/`} 
        class="inline-flex items-center text-orange hover:text-amber-500 transition-colors font-semibold"
      >
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Blog
      </a>
    </div>
  </article>
</BaseLayout>
