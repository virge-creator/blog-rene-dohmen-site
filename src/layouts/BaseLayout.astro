---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "René Dohmen's Blog", 
  description = "Thoughts on code, Linux, music, motorcycles and life"
} = Astro.props;

const fullTitle = title === "René Dohmen's Blog" ? title : `${title} | René Dohmen's Blog`;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Navigation -->
    <nav class="sticky top-0 z-50 bg-dark/80 backdrop-blur-lg border-b border-gray-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
          <div class="flex items-center gap-3">
            <a href={base} class="flex items-center gap-2">
              <img src={`${base}images/logo.png`} alt="RD" class="h-8 w-auto" />
              <span class="text-xl font-bold gradient-text">René Dohmen</span>
            </a>
          </div>
          
          <!-- Desktop Navigation -->
          <div class="hidden md:flex space-x-8">
            <a href={base} class="hover:text-orange transition-colors">Home</a>
            <a href={`${base}blog/`} class="hover:text-orange transition-colors">Blog</a>
            <a href={`${base}about/`} class="hover:text-orange transition-colors">About</a>
            <a href="https://github.com/acidjunk" target="_blank" rel="noopener" class="hover:text-orange transition-colors">
              GitHub
            </a>
          </div>

          <!-- Mobile menu button -->
          <div class="md:hidden">
            <button id="mobile-menu-button" class="text-gray-300 hover:text-orange transition-colors">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Mobile Navigation -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-gray-800">
        <div class="px-2 pt-2 pb-3 space-y-1">
          <a href={base} class="block px-3 py-2 hover:bg-gray-800 hover:text-orange rounded transition-colors">Home</a>
          <a href={`${base}blog/`} class="block px-3 py-2 hover:bg-gray-800 hover:text-orange rounded transition-colors">Blog</a>
          <a href={`${base}about/`} class="block px-3 py-2 hover:bg-gray-800 hover:text-orange rounded transition-colors">About</a>
          <a href="https://github.com/acidjunk" target="_blank" rel="noopener" class="block px-3 py-2 hover:bg-gray-800 hover:text-orange rounded transition-colors">GitHub</a>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 border-t border-gray-800 mt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex flex-col md:flex-row justify-between items-center">
          <div class="mb-4 md:mb-0">
            <p class="text-gray-400">© {new Date().getFullYear()} René Dohmen. All rights reserved.</p>
          </div>
          <div class="flex space-x-6">
            <a href="https://github.com/acidjunk" target="_blank" rel="noopener" class="text-gray-400 hover:text-orange transition-colors">
              GitHub
            </a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      // Mobile menu toggle
      const mobileMenuButton = document.getElementById('mobile-menu-button');
      const mobileMenu = document.getElementById('mobile-menu');
      
      mobileMenuButton?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
